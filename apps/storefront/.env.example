# Base URL of the top-up API, including the /api prefix but NOT the /v1 version
# segment — services add that themselves.
#
# Local:      http://localhost:8000/api
# Staging:    https://staging-api.example.com/api
# Production: injected by .github/workflows/production.yml from the
#             VITE_API_BASE_URL repository secret.
VITE_API_BASE_URL=http://localhost:8000/api

# Laravel Reverb (WebSocket realtime — Pusher protocol). Mirror the backend's
# REVERB_* values. Leave empty to disable realtime and fall back to polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
