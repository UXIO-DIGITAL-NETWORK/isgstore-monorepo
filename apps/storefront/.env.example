# Base URL of the top-up API, including the /api prefix but NOT the /v1 version
# segment — services add that themselves.
#
# Local:      http://localhost:8000/api
# Staging:    https://staging-api.example.com/api
# Production: injected by .github/workflows/production.yml from the
#             VITE_API_BASE_URL repository secret.
VITE_API_BASE_URL=http://localhost:8000/api

# Pusher (hosted, pusher.com) — WebSocket realtime. Mirror the backend's
# PUSHER_APP_KEY / PUSHER_APP_CLUSTER. Leave empty to disable realtime and fall
# back to polling.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap1

# Google Sign-In — OAuth Client ID (Web application) from Google Cloud Console.
# MUST be the same value as the API's GOOGLE_CLIENT_ID. Empty = button hidden.
VITE_GOOGLE_CLIENT_ID=""

# Serve every API request from the bundled fixtures in src/mocks/ instead of the
# network — lets developers/testers see the full layout with no backend. Member
# pages need a mock sign-in (any email/password works). Local only: leave this
# false, and never enable it in a production build.
VITE_USE_MOCK_DATA=false
