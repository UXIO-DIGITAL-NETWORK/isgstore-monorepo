APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Ships false: a production deploy that forgets to override this must NOT leak
# stack traces + env values. Set true only in local .env when debugging.
APP_DEBUG=false
APP_URL=http://localhost

# CORS: comma-separated allowlist of frontend origins (admin, storefront,
# payment). Leave unset for local dev to allow any origin ('*').
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=web_topup_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Consumer storefront base URL — used for the "Track Order" link in the receipt email.
STOREFRONT_URL=http://localhost:5173
STOREFRONT_BRAND="TOPUP GAME"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MONETAPAY_MCH_ID=
MONETAPAY_COLLECTION_APP_ID=
MONETAPAY_DISBURSEMENT_APP_ID=
MONETAPAY_PARTNER_KEY=
MONETAPAY_TOKEN=
MONETAPAY_AES_KEY=
MONETAPAY_AES_IV=
MONETAPAY_IS_PRODUCTION=false
MONETAPAY_SUCCESS_REDIRECT_URL=
MONETAPAY_FAILED_REDIRECT_URL=

# Withdrawal (payout) fee — a flat charge on every merchant withdrawal, amount-independent:
# fee = WITHDRAWAL_FEE_FLAT + round(WITHDRAWAL_FEE_FLAT * WITHDRAWAL_FEE_PERCENT / 100)
#     = 1500 + 165 = 1665; nett = amount - fee.
# WITHDRAWAL_MIN_AMOUNT must exceed the fee so nett stays positive.
WITHDRAWAL_FEE_FLAT=1500
WITHDRAWAL_FEE_PERCENT=11
WITHDRAWAL_MIN_AMOUNT=10000

UXIOTOPUP_API_KEY=
UXIOTOPUP_BASE_URL=https://api.uxiotopup.id
UXIOTOPUP_CALLBACK_URL=
UXIOTOPUP_PRICE_TIER=harga
UXIOTOPUP_CALLBACK_IP=103.146.202.50

DISCORD_WEBHOOK_LOG_URL=

# Google Sign-In — OAuth Client ID (Web application) from Google Cloud Console.
# Same value the frontend sets as VITE_GOOGLE_CLIENT_ID. No client secret needed.
GOOGLE_CLIENT_ID=

# PiWAPI (WhatsApp gateway — delivers the purchase receipt as a document)
# Usually set from the admin Integration page; these are the env fallbacks.
PIWAPI_API_URL=https://piwapi.com/api/send/whatsapp
PIWAPI_ACCOUNT=
PIWAPI_SECRET=

# Pusher (hosted, pusher.com) — WebSocket broadcasting. There is NO self-hosted
# WebSocket server any more; all realtime goes through the external Pusher
# platform. Create an app at dashboard.pusher.com and copy its credentials here.
# IMPORTANT: do NOT wrap values in quotes — a quoted key bakes the quotes into
# the frontend build and pusher-js can never authenticate with it.
PUSHER_APP_ID=2086577
PUSHER_APP_KEY=62dd03c1cd3147812c1b
PUSHER_APP_SECRET=90d7a199c779d15f4b06
PUSHER_APP_CLUSTER=ap1

# Exposed to the Vite frontends (laravel-echo). Mirror the values above (no quotes).
VITE_PUSHER_APP_KEY=${PUSHER_APP_KEY}
VITE_PUSHER_APP_CLUSTER=${PUSHER_APP_CLUSTER}
