<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The default CLI 128M is exhausted mid-suite (PhpSpreadsheet tests
             are the usual straw) — this bounds the whole phpunit process. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Keep outbound gateways unconfigured so the sync queue never makes a
             live call from a test that doesn't Http::fake it (a real .env must
             not change the suite's outcome). -->
        <!-- A real-looking domain, because production has one: the customer-facing
             links are deliberately withheld when the base is localhost or unset,
             and a suite running without them would be testing the degraded path
             everywhere. PublicUrlTest overrides these per case. -->
        <env name="STOREFRONT_URL" value="https://isgstore.id"/>
        <env name="PAYMENT_PAGE_URL" value="https://pay.isgstore.id"/>
        <env name="PIWAPI_ACCOUNT" value=""/>
        <env name="PIWAPI_SECRET" value=""/>
        <!-- Uxio Hub belongs in that list for the same reason, and is the newest
             way a real .env could change the suite's outcome: switching the
             integration on turns on the service-order push, so every test that
             issues a bill starts making a live call the moment a developer (or
             the production server) enables it. Off here; the Hub tests arm it
             themselves via config(). -->
        <env name="HUB_ENABLED" value="false"/>
        <env name="HUB_SITE_API_KEY" value=""/>
        <env name="HUB_BASE_URL" value=""/>
        <env name="HUB_MANAGED_PLAN" value="false"/>
        <env name="HUB_PUSH_ORDERS" value="false"/>
        <env name="HUB_WRITE_ENABLED" value="false"/>
        <env name="HUB_SYNC_INTERVAL_MINUTES" value="1"/>
        <!-- Discord belongs in that list too, and was the one gateway missing
             from it. A developer's .env holds the LIVE channel webhook, and the
             service deliberately lets `testing` through (a test that configures
             a URL is exercising that path on purpose) — so the suite inherited a
             real webhook and every fulfilment test became a would-be post to the
             channel operators actually watch. Tests that want it set it
             themselves via config(). -->
        <env name="DISCORD_WEBHOOK_LOG_URL" value=""/>
    </php>
</phpunit>
