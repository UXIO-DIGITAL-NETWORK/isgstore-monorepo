# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.
#
# In GitHub Actions these are set as environment secrets:
#   Settings → Environments → [staging | production] → Secrets

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://api-topup.uxio-dev.web.id/api

# Laravel Reverb (WebSocket realtime — Pusher protocol). Mirror the backend's
# REVERB_* values. Leave empty to disable realtime and fall back to polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
