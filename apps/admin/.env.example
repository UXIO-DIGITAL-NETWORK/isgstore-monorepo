# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.
#
# In GitHub Actions these are set as environment secrets:
#   Settings → Environments → [staging | production] → Secrets

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=

# Pusher (hosted, pusher.com) — WebSocket realtime. Mirror the backend's
# PUSHER_APP_KEY / PUSHER_APP_CLUSTER. Leave empty to disable realtime and fall
# back to polling.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap1
